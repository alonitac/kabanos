{
  "scene": "15",
  "characters": [
    "אינליאל",
    "דיצה",
    "שיראל",
    "הרב",
    "כרמלה",
    "קלאופטרה",
    "שמעון"
  ],
  "lines": [
    {
      "id": 1,
      "character": "אינליאל",
      "text": "הכל מוכן? איפה הרב? שלום כבודו.  טוב, מכתבים, הספדים, שיר נוגה, קדימה, כבר עשרה לעשר... (נכנסת דיצה)",
      "start": 0.0,
      "end": 8.25
    },
    {
      "id": 2,
      "character": "דיצה",
      "text": "בוקר טוב לכולם.",
      "start": 8.5,
      "end": 10.48
    },
    {
      "id": 3,
      "character": "אינליאל",
      "text": "השגת?",
      "start": 10.55,
      "end": 11.65
    },
    {
      "id": 4,
      "character": "דיצה",
      "text": "חד משמעית.",
      "start": 11.8,
      "end": 13.0
    },
    {
      "id": 5,
      "character": "שיראל",
      "text": "וואי וואיי, תראה! (דיצה מוציאה קופסה עם אקדח) כמה?",
      "start": 13.0,
      "end": 16.3
    },
    {
      "id": 6,
      "character": "דיצה",
      "text": "שש אלף!",
      "start": 16.42,
      "end": 17.2
    },
    {
      "id": 7,
      "character": "הרב",
      "text": "יקר!",
      "start": 17.1,
      "end": 18.937
    },
    {
      "id": 8,
      "character": "כרמלה",
      "text": "גשמי.",
      "start": 18.8,
      "end": 20.1
    },
    {
      "id": 9,
      "character": "דיצה",
      "text": "יקר, אבל תראה איזה חתיך! ממש מתחשק לדפוק כדור.",
      "start": 19.95,
      "end": 24.2
    },
    {
      "id": 10,
      "character": "אינליאל",
      "text": "לעבודה, תעיפו את זה מפה! (לקליאו) שאני לא אראה שבנבנישתי בלי כוסית ביד!",
      "start": 24.21,
      "end": 28.93
    },
    {
      "id": 11,
      "character": "קלאופטרה",
      "text": "(מוזגת לשיראל שארית בקבוק) הכל מזוג, אינלי, הכל מזוג, הכל נגמר!",
      "start": 29.2,
      "end": 33.7
    },
    {
      "id": 12,
      "character": "אינליאל",
      "text": "שמעון, אורח הכבוד, ברוך הבא, ברוך הבא. גש למקום שלך בבקשה, שב! לחיי שמעון, לחייך!",
      "start": 33.9,
      "end": 45.1
    },
    {
      "id": 13,
      "character": "קלאופטרה",
      "text": "שתה, שימי!",
      "start": 45.2,
      "end": 46.9
    },
    {
      "id": 14,
      "character": "כרמלה",
      "text": "חברים, קרובים, אבלים יקרים, ביום זה אנו מלווים את שימי בנבנישתי, למימד אחר שכולו טוב.",
      "start": 46.91,
      "end": 57.0
    },
    {
      "id": 15,
      "character": "דיצה",
      "text": "נאחל לו דרך צלחה. שימי יקר, בחרת ללכת בדרך משלך, בדרך כל חי, ואני מאמין שבבוא העת גם אחרים יצעדו בעקבותיך... המולדת כולה תרעד, ויפתחו שערי ה.. כנסת.",
      "start": 57.1,
      "end": 72.1
    },
    {
      "id": 16,
      "character": "הרב",
      "text": "כל הכבוד, שמעון. אשריך שזכית לקדש שם שמים. יהי חלקך עם הצדיקים. כבוד",
      "start": 72.11,
      "end": 78.7
    },
    {
      "id": 17,
      "character": "כולם",
      "text": "כבוד!",
      "start": 78.71,
      "end": 79.9
    },
    {
      "id": 18,
      "character": "אינליאל",
      "text": "אני מבקש דממה .",
      "start": 79.91,
      "end": 86.6
    },
    {
      "id": 19,
      "character": "שמעון",
      "text": "סליחה, מה השעה?",
      "start": 86.61,
      "end": 89.8
    },
    {
      "id": 20,
      "character": "דיצה",
      "text": "עשר ו15 דקות",
      "start": 89.81,
      "end": 92.6
    },
    {
      "id": 21,
      "character": "כרמלה",
      "text": "אז בלי לחץ בבקשה, לנשום! יש לשמעון עוד המון זמן",
      "start": 92.61,
      "end": 98.8
    },
    {
      "id": 22,
      "character": "שיראל",
      "text": "כן (מביאה מגש) מה קרה, תנשמו, אפשר בצ׳יל, יש זמן עד 12. (לשמעון) תשתה, שימי, תשתה! לחיים! תודה על הג׳סטה, אין כמו שכנות טובה, שמרנו לך... טארטלטים עם מיתוג של ליאן טיפאני.",
      "start": 98.81,
      "end": 111.1
    },
    {
      "id": 23,
      "character": "אינליאל",
      "text": "סלח לי, רגע, שמעון, לפני הכל, הכי חשוב – הצוואה. בבקשה, חסרה רק החתימה שלך.",
      "start": 111.11,
      "end": 128.9
    },
    {
      "id": 24,
      "character": "שמעון",
      "text": "מה? על כולם?",
      "start": 128.91,
      "end": 130.8
    },
    {
      "id": 25,
      "character": "אינל",
      "text": "בן תמותה רגיל, משאיר רק מכתב התאבדות אחד, אבל אדם דגול כמוך, יכול להשאיר כמה מכתבים שמתחשק לו! לא נפריע לך, שמעון.(מניח את המכתבים) מאסטרו, מוסיקה.",
      "start": 130.81,
      "end": 144.4
    },
    {
      "id": 26,
      "character": "הרב",
      "text": "יהי רצון שהקדוש ברוך הוא יהיה בעזרך. זה למען  הדת היהודית.",
      "start": 144.41,
      "end": 149.7
    },
    {
      "id": 27,
      "character": "קלאופטרה",
      "text": "למען האהבה..",
      "start": 149.71,
      "end": 152.2
    },
    {
      "id": 28,
      "character": "דיצה",
      "text": "למען צה״ל",
      "start": 152.21,
      "end": 153.6
    },
    {
      "id": 29,
      "character": "כרמלה",
      "text": "למען האמת",
      "start": 153.61,
      "end": 155.7
    },
        {
      "id": 86,
      "character": "ערבי",
      "text": "למען שחרור פלסטין! די לכיבוש!",
      "start": 155.71,
      "end": 159.4
    },
    {
      "id": 30,
      "character": "אינליאל",
      "text": "למען הרוח",
      "start": 159.41,
      "end": 161.2
    },
    {
      "id": 31,
      "character": "שמעון",
      "text": "האמנות, העסקים, צה\"ל, המסחר, האמת, המסחר..",
      "start": 161.21,
      "end": 167.1
    },
    {
      "id": 32,
      "character": "הרב",
      "text": "כל ישראל ערבים זה לזה",
      "start": 167.11,
      "end": 169.4
    },
    {
      "id": 33,
      "character": "כרמלה",
      "text": "כולנו רקמה אנושית אחת.",
      "start": 169.41,
      "end": 171.6
    },
    {
      "id": 34,
      "character": "דיצה",
      "text": "לא משאירים אף אחד מאחור, כתף אל כתף עד הסוף.",
      "start": 171.61,
      "end": 176.3
    },
    {
      "id": 35,
      "character": "קלאופטרה",
      "text": "אהבה זה לבחור זה בזה , כל יום מחדש",
      "start": 176.31,
      "end": 180.7
    },
    {
      "id": 36,
      "character": "שיראל",
      "text": "כולנו באותה סירה , וחלק עם יאכטה.",
      "start": 180.71,
      "end": 184.7
    },
    {
      "id": 37,
      "character": "אינליאל",
      "text": "כל הציוויליזציה נשענת על ההסכמה שלא מפקירים אדם בתוך חברה.",
      "start": 184.71,
      "end": 190.3
    },
    {
      "id": 38,
      "character": "שיראל",
      "text": "בדיוק, כוחנו באחדותנו.",
      "start": 190.31,
      "end": 192.6
    },
    {
      "id": 39,
      "character": "הרב",
      "text": "ברוך השם",
      "start": 192.61,
      "end": 194.3
    },
    {
      "id": 40,
      "character": "כולם",
      "text": "מזל טוב! חתם על הכל. נמסטה. בראבו",
      "start": 194.31,
      "end": 199.4
    },
    {
      "id": 44,
      "character": "קלאופטרה",
      "text": "מזל טוב לכולם! שמפניה!",
      "start": 199.41,
      "end": 202.16
    },
    {
      "id": 45,
      "character": "שיראל",
      "text": "לחיים! זאת אומרת.... מזל טוב!",
      "start": 202.17,
      "end": 207.9
    },
    {
      "id": 46,
      "character": "דיצה",
      "text": "נראה לי רגע מתאים למטח הכבוד, לא?",
      "start": 207.91,
      "end": 211.5
    },
    {
      "id": 47,
      "character": "שמעון",
      "text": "אפשר לשאול משהו... מה השעה עכשיו?",
      "start": 211.51,
      "end": 215.7
    },
    {
      "id": 48,
      "character": "שיראל",
      "text": "עשרה לאחת עשרה.",
      "start": 211.51,
      "end": 215.7
    },
    {
      "id": 49,
      "character": "שמעון",
      "text": "ומה השעה עכשיו?",
      "start": 218.5,
      "end": 221.5
    },
    {
      "id": 50,
      "character": "שיראל",
      "text": "אחת עשרה ורבע.",
      "start": 218.51,
      "end": 222.7
    },
    {
      "id": 51,
      "character": "קלאופטרה",
      "text": "יש עוד המון זמן עד שתים עשרה, שמעון! אל תחשוב על זה, שתה!",
      "start": 222.71,
      "end": 227.4
    },
    {
      "id": 52,
      "character": "הרב",
      "text": "חביבי, יש זמן ברוך השם!",
      "start": 227.41,
      "end": 229.9
    },
    {
      "id": 53,
      "character": "כרמלה",
      "text": "אפשר אולי סופסוף לתת לך חיבוק פרידה? אל תחשוב על הזמן, שמעון. זה רק מימד, תקשיב! (גונג, שרה..?)",
      "start": 229.91,
      "end": 238.9
    },
    {
      "id": 54,
      "character": "קלאופטרה",
      "text": "(משקה את שימי ורוקדת איתו) יש חיים אחרים, חיים יפים, חיים נהדרים. חיים עם אווירה, עם פרווה, עם תחתוני תחרה,...(עוברת לאינליאל)  אינלי.. בוא נברח ביחד לפאריי! ... אני רוצה דיסוננסים...",
      "start": 240.9,
      "end": 255.2
    },
    {
      "id": 55,
      "character": "דיצה",
      "text": "אפשר לשתות פה משהו?",
      "start": 255.21,
      "end": 257.5
    },
    {
      "id": 56,
      "character": "שיראל",
      "text": "(מוזגת לכולם)\tמה תרצו?",
      "start": 257.51,
      "end": 258.9
    },
    {
      "id": 57,
      "character": "אינליאל",
      "text": "דיסוננסים. פעמיים. לי ולגברת (קלאופטרה)",
      "start": 258.91,
      "end": 262.3
    },
    {
      "id": 58,
      "character": "שמעון",
      "text": "יש לי שאלה...  יש חיים אחרי זה?",
      "start": 262.31,
      "end": 266.2
    },
    {
      "id": 59,
      "character": "שיראל",
      "text": "זה תשאל את הרב. זאת המומחיות שלו! רבנו, בוא רגע, בוא הנה, חתיכת אלכוהוליסט!",
      "start": 266.21,
      "end": 272.4
    },
    {
      "id": 60,
      "character": "הרב",
      "text": "זה תירוש, לקידוש.",
      "start": 272.41,
      "end": 274.1
    },
    {
      "id": 61,
      "character": "אינליאל",
      "text": "זה שיבס וזה הרביעי כבר. רבותי, יש למנוח שאלה.",
      "start": 274.11,
      "end": 279.3
    },
    {
      "id": 62,
      "character": "שמעון",
      "text": "כבוד הרב, תגיד לי בבקשה, יש חיים אחרים אחרי זה?",
      "start": 279.31,
      "end": 284.8
    },
    {
      "id": 63,
      "character": "הרב",
      "text": "יש .. עראק.",
      "start": 284.81,
      "end": 288.5
    },
    {
      "id": 64,
      "character": "שמעון",
      "text": "תגיד לי את האמת!",
      "start": 288.51,
      "end": 290.4
    },
    {
      "id": 65,
      "character": "כרמלה",
      "text": "בקרוב תפגוש אותה",
      "start": 290.41,
      "end": 292.6
    },
    {
      "id": 66,
      "character": "אינליאל",
      "text": "בעוד שלושים דקות תגלה בעצמך.",
      "start": 292.61,
      "end": 295.1
    },
    {
      "id": 67,
      "character": "שמעון",
      "text": "בעוד שלושים? מה, כבר אחת עשרה וחצי?",
      "start": 295.11,
      "end": 298.4
    },
    {
      "id": 68,
      "character": "אינליאל",
      "text": "יותר!",
      "start": 298.41,
      "end": 299.6
    },
    {
      "id": 69,
      "character": "שמעון",
      "text": "חברים, פתאום הבנתי מתי מתחילים החיים האמיתיים. החיים האמיתיים מתחילים שלושים דקות לפני המוות... חברים, אתם יודעים מה אני יכול? אני יכול הכל, הכל. אני לא פוחד מאף אחד. אף אחד. מבינים? אני עושה מה שבא לי. אלוהים! אני כל יכול. לא פוחד מאף אחד. פעם ראשונה בחיים, לא פוחד מאף אחד. עושה מה שבא לי. אפילו אם יבוא לי לרוץ למשכן הכנסת ולהוריד את המכנסיים!",
      "start": 299.61,
      "end": 317.6
    },
    {
      "id": 70,
      "character": "דיצה",
      "text": "צצצצצ",
      "start": 317.61,
      "end": 319.2
    },
    {
      "id": 71,
      "character": "קלאופטרה",
      "text": "הוא גאון!",
      "start": 319.21,
      "end": 320.7
    },
    {
      "id": 72,
      "character": "שמעון",
      "text": "עוד מילדות רציתי להיות גאון, אבל ההורים שלי היו נגד. בשביל מַה חייתי? בשביל  מה אתם חיים? בשביל הסטטיסטיקה. אי, חיים, כמה שנים עיניתם אותי! כמה שנים השפלתם אותי, חיים ארורים שלי. אבל היום הגיעה שעתי. האם חיינו רע? לא, לא חיינו רע, אבל לא ידענו איך לחיות... ועכשיו גיליתי!",
      "start": 320.71,
      "end": 332.5
    },
    {
      "id": 73,
      "character": "אינליאל",
      "text": "פחות מחצי שעה .",
      "start": 332.51,
      "end": 335.0
    },
    {
      "id": 74,
      "character": "שיראל",
      "text": "שתוק! תן לו לדבר! הבן אדם כביר!",
      "start": 335.01,
      "end": 338.6
    },
    {
      "id": 75,
      "character": "שמעון",
      "text": "השאלה על מי? על מה אני אנסה את הכוח החדש שלי? אולי על הרמטכל?",
      "start": 338.61,
      "end": 344.7
    },
        {
      "id": 76,
      "character": "דיצה",
      "text": "חרפה. ימית עלינו קלון. (יוצאת)",
      "start": 344.71,
      "end": 348.6
    },
        {
      "id": 77,
      "character": "שמעון",
      "text": "אולי על האדמור?",
      "start": 348.61,
      "end": 350.0
    },
    
    {
      "id": 78,
      "character": "הרב",
      "text": "השם ירחם!",
      "start": 350.01,
      "end": 351.9
    },

          {
      "id": 79,
      "character": "שמעון",
      "text": "אולי על מאסק?",
      "start": 351.91,
      "end": 353.9
    },

          {
      "id": 80,
      "character": "שיראל",
      "text": "אל תיגע לי בטסלה",
      "start": 353.91,
      "end": 355.7
    },
              {
      "id": 81,
      "character": "שמעון",
      "text": "אני יודע אני צריך ללכת על הכי גדול, הכי חזק, הכי משוגע! אני אתקשר לטראמפ ואני אגיד לו איך צריך לעשות את זה!",
      "start": 355.71,
      "end": 364.2
    },

    {
      "id": 82,
      "character": "קלאופטרה",
      "text": "לא צריך, שמעון.",
      "start": 364.21,
      "end": 368.6
    },
    {
      "id": 83,
      "character": "אינליאל",
      "text": "מה אתה עושה?",
      "start": 368.61,
      "end": 371.7
    },
    {
      "id": 84,
      "character": "כרמלה",
      "text": "תעצרו אותו!",
      "start": 371.71,
      "end": 373.4
    },
    {
      "id": 85,
      "character": "שמעון",
      "text": "....",
      "start": 373.41,
      "end": 415.2
    },
    {
      "id": 86,
      "character": "אינליאל",
      "text": "מה קרה?",
      "start": 415.21,
      "end": 417.9
    },
    {
      "id": 87,
      "character": "שמעון",
      "text": "ניתקה. נבהלה. נבהלה ממני. אתם מרגישים? הבנתם מה קורה פה? פוחדים. ראש הממשלה – פוחד ממני.",
      "start": 417.91,
      "end": 427.6
    },
    {
      "id": 88,
      "character": "שיראל",
