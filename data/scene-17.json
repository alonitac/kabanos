{
  "scene": "17",
  "characters": [
    "אינליאל",
    "לילי",
    "הרב",
    "שיראל",
    "שרה",
    "מישה"
  ],
  "lines": [
    {
      "id": 1,
      "character": "אינליאל",
      "text": "אתן מוכנות לילי?",
      "start": 0.0,
      "end": 1.6
    },
    {
      "id": 2,
      "character": "לילי",
      "text": "תסלח לי, אינלי...",
      "start": 1.9,
      "end": 4.03 
    },
    {
      "id": 3,
      "character": "אינליאל",
      "text": "אל.",
      "start": 4.05,
      "end": 4.6
    },
    {
      "id": 4,
      "character": "לילי",
      "text": "למה אנחנו צריכות להיות מוכנות?",
      "start": 4.85,
      "end": 7.18
    },
    {
      "id": 5,
      "character": "הרב",
      "text": "הלוויתו של שימי בנבנישתי יוצאת לדרך. נאמר קדיש. אביו של המנוח פה?",
      "start": 7.27,
      "end": 12.25
    },
    {
      "id": 6,
      "character": "לילי",
      "text": "נפטר.",
      "start": 12.34,
      "end": 12.82
    },
    {
      "id": 7,
      "character": "הרב",
      "text": "אמו? בנו? בתו? (על הכל היא עונה בשלילה)",
      "start": 13.32,
      "end": 17.5
    }, 
    {
      "id": 9,
      "character": "לילי",
      "text": "מיאמי... ובלגרד.",
      "start": 17.2,
      "end": 18.9
    },
    {
      "id": 10,
      "character": "הרב",
      "text": "אחיותיו?",
      "start": 18.8,
      "end": 19.5
    },
    {
      "id": 11,
      "character": "לילי",
      "text": "ליסבון, קופנגן, טורונטו ו..ערד.",
      "start": 19.6,
      "end": 21.5
    },
    {
      "id": 12,
      "character": "הרב",
      "text": "אשתו?",
      "start": 21.8,
      "end": 22.3
    },
    {
      "id": 13,
      "character": "לילי",
      "text": "זאת אני, אבל כבוד הרב... הוא חי!",
      "start": 22.6,
      "end": 25.6
    },
    {
      "id": 14,
      "character": "הרב",
      "text": "מה זאת אומרת חי?",
      "start": 25.5,
      "end": 26.9
    },
    {
      "id": 15,
      "character": "אינליאל",
      "text": "הוא חי, בוודאי , בלב של כולנו, ותמיד ימשיך לחיות...",
      "start": 26.91,
      "end": 32.5
    },
    {
      "id": 16,
      "character": "שיראל",
      "text": "נקים פיאצת הנצחה עם מזרקת אינפיניטי בבניין לזכרו מאמי,  מזמן רציתי מזרקה.",
      "start": 32.87,
      "end": 39.6
    },
    {
      "id": 17,
      "character": "שרה",
      "text": "הוא באמת חי! תקום, חתיכת אלכוהוליסט מסריח!",
      "start": 39.601,
      "end": 44.27
    },
    {
      "id": 18,
      "character": "שיראל",
      "text": "השכול, השכול מערער את השפיות. לייסטר, חראם.",
      "start": 44.28,
      "end": 48.2
    },
    {
      "id": 19,
      "character": "מישה",
      "text": "נו, זו תופעה ידועה, זה בגלל שהן לא ציפו, אני עצמי קברתי את אשתי לא מזמן. לא הצלחתי לישון בלילה. תשאלי אפילו את מרגריטה, היא עדה.",
      "start": 48.21,
      "end": 57.5
    },
    {
      "id": 20,
      "character": "שיראל",
      "text": "אני כשכנה גם עדה, שמעתי היטב .",
      "start": 57.51,
      "end": 60.3
    },
    {
      "id": 21,
      "character": "מישה",
      "text": "טוב, אם זה המצב, כשכן, אני הכי קרוב אליו... למדתי זה באולפן יִתְגַּדַּל וְיִתְקַדַּשׁ שמי ר....",
      "start": 60.6,
      "end": 67.5
    },
    {
      "id": 22,
      "character": "לילי",
      "text": "מישה!",
      "start": 67.501,
      "end": 68.3
    },
    {
      "id": 23,
      "character": "אינליאל",
      "text": "רגע, רגע! בן אדם כמו שימי אי אפשר לקבור ככה, בתכריכים, כמו חתול.",
      "start": 113.65,
      "end": 113.66
    },
    {
      "id": 24,
      "character": "הרב",
      "text": "מה אתה רוצה שנעשה אתו בדיוק?",
      "start": 113.66,
      "end": 113.67
    },
    {
      "id": 25,
      "character": "אינליאל",
      "text": "שמעון צריך להקבר בארוןֿ, טקס חילוני, תרבותי, עם טקסט מכבד, משהו של ביאליק.",
      "start": 68.4,
      "end": 77.5
    },
    {
      "id": 26,
      "character": "הרב",
      "text": "חס ושלום, כופר בן כופר, שיהודי יקבר בארון?!",
      "start": 77.51,
      "end": 80.9
    },
    {
      "id": 27,
      "character": "אינליאל",
      "text": "זה מה שהמנוח היה רוצה! הוא היה אדם מתקדם! אתאיסט ואיש תרבות!",
      "start": 81.0,
      "end": 99.8
    },
    {
      "id": 28,
      "character": "הרב",
      "text": "על מי ששם ידו בנפשו לא אומרים קדיש, ולא שיר של ביאליק ולא שום דבר!",
      "start": 99.81,
      "end": 103.9
    },
    {
      "id": 29,
      "character": "אינליאל",
      "text": "פרימיטיב.",
      "start": 103.91,
      "end": 104.6
    },
    {
      "id": 30,
      "character": "הרב",
      "text": "קוקסינל...",
      "start": 104.61,
      "end": 105.4
    },
    {
      "id": 31,
      "character": "לילי",
      "text": "די!! זה בעלי שם..הוא חי!",
      "start": 105.3,
      "end": 108.2
    },
    {
      "id": 32,
      "character": "הרב",
      "text": "מה לעשות, זאת ההלכה.",
      "start": 108.3,
      "end": 110.03
    },
    {
      "id": 33,
      "character": "שרה",
      "text": "פרחחים, עצרו!",
      "start": 110.1,
      "end": 111.6
    },
    {
      "id": 34,
      "character": "מישה",
      "text": "פיזדייץ",
      "start": 111.7,
      "end": 112.9
    },
    {
      "id": 35,
      "character": "שיראל",
      "text": "תפסיקו, זה כתם על היוקרה של הבניין!",
      "start": 112.91,
      "end": 115.22
    }
  ]
}