{
  "scene": "16",
  "characters": [
    "שרה",
    "לילי",
    "שליח",
    "אינליאל",
    "להביע תנחומים כנים",
    "קלאופטרה",
    "ברונו",
    "הנרייטה",
    "שיראל",
    "שמעון"
  ],
  "lines": [
    {
      "id": 1,
      "character": "שרה",
      "text": "לילי תורידי את זה, זה מזל רע. עשיתי סיבוב, קניתי לשימי כמה דברים.",
      "start": 2.62,
      "end": 4.46
    },
    {
      "id": 2,
      "character": "לילי",
      "text": "מה קנית לו?",
      "start": 4.68,
      "end": 5.26
    },
    {
      "id": 3,
      "character": "שרה",
      "text": "ביצים. ו- ויסקי טוב, לחגוג את המשרה החדשה.",
      "start": 5.72,
      "end": 7.12
    },
    {
      "id": 4,
      "character": "לילי",
      "text": "טוב, הוא תיכף פה. (מציגה קולבים עם שמלות) זה או זה ?",
      "start": 11.02,
      "end": 11.48
    },
    {
      "id": 5,
      "character": "שרה",
      "text": "מאיפה לי? תשארי עם תחתונים, הכי טוב. חום אימים",
      "start": 11.86,
      "end": 12.52
    },
    {
      "id": 6,
      "character": "לילי",
      "text": "מה את אומרת.. ילך לו במקום החדש?",
      "start": 15.66,
      "end": 17.9
    },
    {
      "id": 7,
      "character": "שרה",
      "text": "מה זאת אומרת? ברור שילך, אני בתחושה שהפעם זה להרבה זמן.",
      "start": 20.28,
      "end": 22.7
    },
    {
      "id": 8,
      "character": "לילי",
      "text": "נחיה כמו בני אדם, אמא?",
      "start": 23.2,
      "end": 24.56
    },
    {
      "id": 9,
      "character": "שרה",
      "text": "נחיה, ברור שנחיה.",
      "start": 25.12,
      "end": 27.12
    },
    {
      "id": 10,
      "character": "לילי",
      "text": "ויהיו לנו ילדים.",
      "start": 27.42,
      "end": 28.28
    },
    {
      "id": 11,
      "character": "שרה",
      "text": "יהיו ברור שיהיו.",
      "start": 28.28,
      "end": 30.3
    },
    {
      "id": 12,
      "character": "לילי",
      "text": "מיקה וארי..",
      "start": 30.66,
      "end": 31.92
    },
    {
      "id": 13,
      "character": "שרה",
      "text": "ארי, תפסיק למשוך למיקה בצמות!",
      "start": 32.42,
      "end": 35.12
    },
    {
      "id": 14,
      "character": "לילי",
      "text": "את לא תצעקי עליו. תראי איך ארי דומה לשימי. ומיקה כל כך יפה, היא דומה...",
      "start": 35.2,
      "end": 36.22
    },
    {
      "id": 15,
      "character": "שרה",
      "text": "לסבתא.",
      "start": 38.42,
      "end": 41.38
    },
    {
      "id": 16,
      "character": "לילי",
      "text": "מיקה תנגן בגיטרה. ארי בתופים.",
      "start": 42.3,
      "end": 44.68
    },
    {
      "id": 17,
      "character": "שרה",
      "text": "ואז באמת יגרשו אותנו מהדירה הזאת.",
      "start": 44.84,
      "end": 47.24
    },
    {
      "id": 18,
      "character": "לילי",
      "text": "והם יגידו – אמא, אבא, סבתא... ( הרחבת טקסט).",
      "start": 47.36,
      "end": 50.06
    },
    {
      "id": 19,
      "character": "שרה",
      "text": "סבתא שרה – בואי נרקוד...",
      "start": 50.24,
      "end": 52.5
    },
    {
      "id": 20,
      "character": "לילי",
      "text": "אמא... תודה.",
      "start": 52.68,
      "end": 54.86
    },
    {
      "id": 21,
      "character": "שליח",
      "text": "משפחת בנבנישתי? תחתמי לי כאן.",
      "start": 57.08,
      "end": 59.86
    },
    {
      "id": 22,
      "character": "שרה",
      "text": "מי כותב לך?",
      "start": 61.2,
      "end": 62.18
    },
    {
      "id": 23,
      "character": "לילי",
      "text": "אמא, זה בשבילך.",
      "start": 62.94,
      "end": 64.04
    },
    {
      "id": 24,
      "character": "שרה",
      "text": ". \"שרה הנכבדת, כשתקראי את המכתב הזה, כבר לא אהיה בין החיים. ספרי זאת בבקשה בעדינות ללילי.. מסרי שאהבתי אותה..מאוד.. שאני מצטער, ולך שרה, אני מאחל - בריאות. שימי.",
      "start": 71.66,
      "end": 74.82
    },
    {
      "id": 25,
      "character": "אינליאל",
      "text": "בבקשה... קרובי המנוח היקרים. תרשו לי, בשם התרבות הישראלית...",
      "start": 88.56,
      "end": 92.68
    },
    {
      "id": 26,
      "character": "להביע תנחומים כנים",
      "text": "שמעון לבדו, לגמרי לבדו, אם אקדח ביד, במודעות מלאה, נכנס לפנתאון הישראלי ונשכב שם לעד.",
      "start": 99.5,
      "end": 102.84
    },
    {
      "id": 27,
      "character": "שרה",
      "text": "איפה נשכב?",
      "start": 111.36,
      "end": 112.62
    },
    {
      "id": 28,
      "character": "אינליאל",
      "text": "בפנתאון הישראלי.  אנחנו, חבריו הקרובים, נדאג שהלוויה של המנוח תעבור באווירה חגיגית, כפי שהיה רוצה. יש לנו עשר דקות. אינליאל",
      "start": 116.36,
      "end": 117.44
    },
    {
      "id": 29,
      "character": "קלאופטרה",
      "text": "קליאופטרה, זוגתו.",
      "start": 126.38,
      "end": 128.36
    },
    {
      "id": 30,
      "character": "אינליאל",
      "text": "לשעבר.",
      "start": 130.28,
      "end": 130.96
    },
    {
      "id": 31,
      "character": "ברונו",
      "text": "ברונו, סושיאליסט, אלגוריתמאי, טרנדולוג, מהנדס חשיפה, אדריכל תודעה.",
      "start": 133.62,
      "end": 135.7
    },
    {
      "id": 32,
      "character": "הנרייטה",
      "text": "הנרייטה, סטייליסטית מפריז.",
      "start": 139.9,
      "end": 141.0
    },
    {
      "id": 33,
      "character": "שרה",
      "text": "מפריז?",
      "start": 141.54,
      "end": 143.52
    },
    {
      "id": 34,
      "character": "קלאופטרה",
      "text": "מ\"אופנת פריז\", במרכז המסחרי.",
      "start": 144.44,
      "end": 146.56
    },
    {
      "id": 35,
      "character": "הנרייטה",
      "text": "איזו שמלה את בוחרת? משי , קטיפה או תחרה שחורה?",
      "start": 155.2,
      "end": 157.08
    },
    {
      "id": 36,
      "character": "ברונו",
      "text": "ממליץ על שסע, מחשוף צר אבל עמוק, קלאסי אלמנות,  סניקרס לבנות. הכי נון שאלאנט, פלוס כבוד למת.",
      "start": 166.18,
      "end": 167.08
    },
    {
      "id": 37,
      "character": "הנרייטה",
      "text": "או - יש לך כזאת מקטיפה, אפשר לתת טוויסט היפטרי עם כובע ורשת דקה, ואיזה פרח קנאביס. הזדמנות לתת שואו.",
      "start": 175.26,
      "end": 176.54
    },
    {
      "id": 38,
      "character": "לילי",
      "text": "אני לא רוצה כלום.. מה זה... תעזבו אותי ... אמאלה..",
      "start": 177.78,
      "end": 180.18
    },
    {
      "id": 39,
      "character": "שיראל",
      "text": "בובית, משתתפת בצערך.. אבל כפרה, כבוד לנפטר,  למה להיראות הכי סמרטוט מכולן, כמו תמיד?  מדובר בלוויה של הביוק.",
      "start": 186.2,
      "end": 187.78
    },
    {
      "id": 40,
      "character": "שרה",
      "text": "איזה ביוק, מה את מדברת? אין לנו כסף אפילו ללוויה, ואלה עוד מציעים פה שמלות מעוצבות...",
      "start": 194.32,
      "end": 195.26
    },
    {
      "id": 41,
      "character": "אינליאל",
      "text": "אל דאגה, שרה. הכל ממומן על ידי החברים שלו! עד הגרוש האחרון!",
      "start": 202.28,
      "end": 203.12
    },
    {
      "id": 42,
      "character": "שיראל",
      "text": "אל תחשבי על כסף!",
      "start": 207.62,
      "end": 208.48
    },
    {
      "id": 43,
      "character": "שרה",
      "text": "באמת? אז אני גם יכולה כובע כזה?",
      "start": 209.14,
      "end": 209.86
    },
    {
      "id": 44,
      "character": "ברונו",
      "text": "ממש לא. את יכולה- כזה.",
      "start": 213.2,
      "end": 214.02
    },
    {
      "id": 45,
      "character": "לילי",
      "text": "אמא..",
      "start": 216.84,
      "end": 217.34
    },
    {
      "id": 46,
      "character": "ברונו",
      "text": "(מניח רינג תאורה) הנרייטה, פנים, סדרי לה את הדמעות!",
      "start": 219.98,
      "end": 220.82
    },
    {
      "id": 47,
      "character": "לילי",
      "text": "מה את עושה? לא! לא בעיניים!...",
      "start": 222.06,
      "end": 222.72
    },
    {
      "id": 48,
      "character": "ברונו",
      "text": "מצויין",
      "start": 224.26,
      "end": 225.8
    },
    {
      "id": 49,
      "character": "קלאופטרה",
      "text": "הנה, שי צנוע ממני, עבודת-יד – תכריכים ממשי.",
      "start": 229.14,
      "end": 229.84
    },
    {
      "id": 50,
      "character": "אינליאל",
      "text": "אל תבכי, אלמנה, בעלך מת כגיבור – על מה יש לך לבכות?",
      "start": 232.86,
      "end": 234.2
    },
    {
      "id": 51,
      "character": "לילי",
      "text": "איך אני אמשיך לחיות?... אלוהים..",
      "start": 236.8,
      "end": 238.72
    },
    {
      "id": 52,
      "character": "אינליאל",
      "text": "תקשיבי לי, תחיי כמו שבעלך מת, בגדול. האח הידד לאלמנת המנוח היקר שלנו, האח הידד (כבוד- כפיים)לאשתו של בנבנישתי! כבוד!",
      "start": 240.2,
      "end": 241.02
    },
    {
      "id": 53,
      "character": "כולם",
      "text": "כפיים!",
      "start": 269.92,
      "end": 271.2
    },
    {
      "id": 54,
      "character": "אינליאל",
      "text": "תרשי לי לנשק אותך בשם כל הנוכחים. (מנשק)",
      "start": 302.64,
      "end": 302.82
    },
    {
      "id": 55,
      "character": "קלאופטרה",
      "text": "אינלי!",
      "start": 303.1,
      "end": 303.52
    },
    {
      "id": 56,
      "character": "אינליאל",
      "text": "חולשה לאלמנות.",
      "start": 303.52,
      "end": 316.85,
      "interpolated": true
    },
    {
      "id": 57,
      "character": "קלאופטרה",
      "text": "מרד.",
      "start": 330.18,
      "end": 332.22
    },
    {
      "id": 58,
      "character": "ברונו",
      "text": "צולם.",
      "start": 332.22,
      "end": 335.31,
      "interpolated": true
    },
    {
      "id": 59,
      "character": "שרה",
      "text": "לא מבינה כלום, איפה הוא?",
      "start": 335.31,
      "end": 338.39,
      "interpolated": true
    },
    {
      "id": 60,
      "character": "אינליאל",
      "text": "אל דאגה, הארון יגיע. אנחנו נשאיר אתכם לבד עכשיו, נחזור בקרוב. עכשיו עשרה לארבע, בעוד שעה, רבותי, כולם כאן לטקס החגיגי. אנחנו לא נזנח אתכן בשעה קשה זאת. אנחנו תמיד לצדכן.",
      "start": 341.48,
      "end": 342.1
    },
    {
      "id": 61,
      "character": "שרה",
      "text": "איזה יחס, ראית? יש עדיין אנשים טובים בעולם.",
      "start": 342.1,
      "end": 342.32,
      "interpolated": true
    },
    {
      "id": 62,
      "character": "לילי",
      "text": "שימי – אין. אין יותר שימי. גבר שלי .",
      "start": 342.54,
      "end": 342.86
    },
    {
      "id": 63,
      "character": "שרה",
      "text": "אל תנגבי בשמלה, את מלכלכת אותה. זה משי, לילי.",
      "start": 343.14,
      "end": 344.42
    },
    {
      "id": 64,
      "character": "לילי",
      "text": "זה לא חיים. למה לי לחיות, אם לא ידעתי אפילו דקה אחת של אושר?",
      "start": 380.86,
      "end": 381.66
    },
    {
      "id": 65,
      "character": "לילי",
      "text": "שימי, מתוק שלי, מה עשית, שימי. לא הצלחתי לשמור עליך, שימי! (בוכה)",
      "start": 381.82,
      "end": 382.78
    },
    {
      "id": 66,
      "character": "שרה",
      "text": "מה עשית, שמעון?",
      "start": 397.98,
      "end": 399.28
    },
    {
      "id": 67,
      "character": "שמעון",
      "text": "תחזיקו אותי, תחזיקו! אני עפה, אני עפה! אל מלא רחמים!",
      "start": 421.24,
      "end": 422.44
    },
    {
      "id": 68,
      "character": "לילי",
      "text": "שימי!",
      "start": 437.4,
      "end": 439.32
    },
    {
      "id": 69,
      "character": "שרה",
      "text": "שמעון!",
      "start": 439.32,
      "end": 444.29,
      "interpolated": true
    },
    {
      "id": 70,
      "character": "שמעון",
      "text": "מי את?",
      "start": 449.26,
      "end": 450.9
    },
    {
      "id": 71,
      "character": "לילי",
      "text": "זאת אני, לילי...",
      "start": 450.9,
      "end": 465.57,
      "interpolated": true
    },
    {
      "id": 72,
      "character": "שמעון",
      "text": "לילילילילי....",
      "start": 480.24,
      "end": 480.76
    },
    {
      "id": 73,
      "character": "לילי",
      "text": "הנה גם שרה פה...",
      "start": 480.76,
      "end": 482.99,
      "interpolated": true
    },
    {
      "id": 74,
      "character": "שמעון",
      "text": "שרה אמנו.איפה רחל ורבקה?",
      "start": 482.99,
      "end": 485.23,
      "interpolated": true
    },
    {
      "id": 75,
      "character": "שרה",
      "text": "לא לאה אמנו ולא שרה אמנו, אלא לילי אשתנו, ושרה חמותינו, חתיכת פסיכי!",
      "start": 487.46,
      "end": 488.9
    },
    {
      "id": 76,
      "character": "שמעון",
      "text": "אני מבקשת למחול לי על כל החטאים, אני לא אשמה.",
      "start": 488.9,
      "end": 491.62,
      "interpolated": true
    },
    {
      "id": 77,
      "character": "לילי",
      "text": "מה זה \"לא אשמה\"?",
      "start": 491.62,
      "end": 494.34,
      "interpolated": true
    },
    {
      "id": 78,
      "character": "שמעון",
      "text": "אלוהים? אדון עולם אשר יצר, אני מבקשת מחילה, לא זיהיתי אותך. נעים מאוד, הנשמה של בנבנישתי.",
      "start": 494.34,
      "end": 497.06,
      "interpolated": true
    },
    {
      "id": 79,
      "character": "לילי",
      "text": "הוא התחרפן, אמא. שימי מה לקחת?",
      "start": 499.78,
      "end": 499.8
    },
    {
      "id": 80,
      "character": "שרה",
      "text": "שמעון, מה עשית?",
      "start": 511.46,
      "end": 512.74
    },
    {
      "id": 81,
      "character": "שמעון",
      "text": "שנים הייתי מיוסרת. אדון עולם, אני מתחננת, תאמין לי, יש לי חלקה בעולם הבא, ליד כס הכבוד, אני רוצה לשיר ולרקוד עם כרובים ומלאכים (שר)",
      "start": 544.56,
      "end": 544.92
    },
    {
      "id": 82,
      "character": "שרה",
      "text": "די עם זה!",
      "start": 545.46,
      "end": 545.96
    },
    {
      "id": 83,
      "character": "שמעון",
      "text": "אבינו שבשמיים...",
      "start": 545.96,
      "end": 550.39,
      "interpolated": true
    },
    {
      "id": 84,
      "character": "שרה",
      "text": "אני לא אבינו שבשמיים, אני חמותך שעל האדמה.",
      "start": 554.82,
      "end": 555.68
    },
    {
      "id": 85,
      "character": "שמעון",
      "text": "מי?",
      "start": 559.0,
      "end": 559.18
    },
    {
      "id": 86,
      "character": "לילי",
      "text": "זה טירוף. (רוכנת אליו) שימי, אהוב שלי!",
      "start": 559.18,
      "end": 560.3,
      "interpolated": true
    },
    {
      "id": 87,
      "character": "שרה",
      "text": "כן, טירוף, תריחי אותו! איזה שלוליות ליקקת, שמעון? אתה לא מתבייש?",
      "start": 560.3,
      "end": 561.41,
      "interpolated": true
    },
    {
      "id": 88,
      "character": "לילי",
      "text": "כותב מכתב שאתה עומד להתאבד, ובמקום זה הולך לדפוק את הראש? אתה פשוט... אני פה גמורה..",
      "start": 561.41,
      "end": 562.53,
      "interpolated": true
    },
    {
      "id": 89,
      "character": "שרה",
      "text": "הדור שלכם גמור, גמור!",
      "start": 562.53,
      "end": 563.65,
      "interpolated": true
    },
    {
      "id": 90,
      "character": "לילי",
      "text": "אני פה מתאבלת, עומדת למות בעצמי מרוב עצב, ואתה בכלל לא מת, שותה חוגג, וחוזר הביתה מסריח כמו...",
      "start": 563.65,
      "end": 564.76,
      "interpolated": true
    },
    {
      "id": 91,
      "character": "שרה",
      "text": "בהמה!",
      "start": 565.88,
      "end": 567.26
    },
    {
      "id": 92,
      "character": "שמעון",
      "text": "זה כבר העולם הבא או עדיין הקודם?",
      "start": 567.26,
      "end": 567.26,
      "interpolated": true
    },
    {
      "id": 93,
      "character": "שרה",
      "text": "הקודם, הקודם...",
      "start": 567.26,
      "end": 567.26,
      "interpolated": true
    },
    {
      "id": 94,
      "character": "שמעון",
      "text": "רגע! מה השעה?",
      "start": 567.26,
      "end": 567.26,
      "interpolated": true
    },
    {
      "id": 95,
      "character": "לילי",
      "text": "השעה שתיים, שימי.",
      "start": 567.26,
      "end": 567.26,
      "interpolated": true
    },
    {
      "id": 96,
      "character": "שמעון",
      "text": "שתיים. איך זה קרה? אלוהים! בשתים עשרה אני צריך... בשתים עשרה, לילי! רגע! מתי חזרתי הביתה?",
      "start": 567.26,
      "end": 567.26,
      "interpolated": true
    },
    {
      "id": 97,
      "character": "שרה",
      "text": "לא חזרת, הוחזרת. סחבו אותך לפה.",
      "start": 567.26,
      "end": 567.26,
      "interpolated": true
    },
    {
      "id": 98,
      "character": "שמעון",
      "text": "סחבו.. מי סחב?",
      "start": 567.26,
      "end": 567.26,
      "interpolated": true
    },
    {
      "id": 99,
      "character": "שרה",
      "text": "שני רעולי פנים, אני יודעת מי זה...",
      "start": 567.26,
      "end": 567.26,
      "interpolated": true
    },
    {
      "id": 100,
      "character": "שמעון",
      "text": "שני רעולי פנים... באמת... היה איזה משהו.. הייתי ברחוב.. פתאום הם התיישבו ו... ישר מהבקבוק.... שתיתי בשביל שיהיה לי אומץ, בשביל האומץ שתיתי ושתיתי. ועם הבקבוק האחרון הלכתי מאחורי עץ, חשבתי לשתות עוד לגימה ולירות. לשתות – שתיתי, אבל לירות – לא יריתי.",
      "start": 567.26,
      "end": 567.26,
      "interpolated": true
    },
    {
      "id": 101,
      "character": "לילי",
      "text": "בשביל מה היית צריך כל הקומדיה הזאת?",
      "start": 567.26,
      "end": 567.26,
      "interpolated": true
    },
    {
      "id": 102,
      "character": "שמעון",
      "text": "מה, היו פה אורחים?",
      "start": 567.26,
      "end": 567.26,
      "interpolated": true
    },
    {
      "id": 103,
      "character": "שרה",
      "text": "היו כמה, האמנות הישראלית, הדת היהודית, צה\"ל... נשאו דברים, נאמו נאומים... הביעו תנחומים.",
      "start": 567.26,
      "end": 567.26,
      "interpolated": true
    },
    {
      "id": 104,
      "character": "לילי",
      "text": "בעלך מת כגיבור, כל ההוצאות עלינו, עליהם! שימי..(מבנה) צריך לברוח, אמא! חייבים איכשהו לגרום להם שלא יגיעו לפה,",
      "start": 567.26,
      "end": 567.26,
      "interpolated": true
    },
    {
      "id": 105,
      "character": "שרה",
      "text": "ולהחזיר את השמלות",
      "start": 567.26,
      "end": 567.26,
      "interpolated": true
    },
    {
      "id": 106,
      "character": "לילי",
      "text": "צריך לברוח!",
      "start": 567.26,
      "end": 567.26,
      "interpolated": true
    },
    {
      "id": 107,
      "character": "שמעון",
      "text": "חכו רגע, לא הכל אבוד. אני עוד יכול להתאבד.",
      "start": 567.26,
      "end": 567.26,
      "interpolated": true
    },
    {
      "id": 108,
      "character": "שרה",
      "text": "שמעון, די , תחליף בגדים.",
      "start": 567.26,
      "end": 567.26,
      "interpolated": true
    },
    {
      "id": 109,
      "character": "לילי",
      "text": "שימי מה קרה?",
      "start": 567.26,
      "end": 567.26,
      "interpolated": true
    },
    {
      "id": 110,
      "character": "שמעון",
      "text": "שתיתי.. כמה שתיתי... חיזקתי את הכנפיים, אמרתי לעצמי, תירה כבר, חתיכת אפס, תירה. תשחיל כדור, נבלה, תשחיל! לא יכול! אלוהים! תן לי כוח , אתה רואה שאני לא מצליח! אני לא יכול לבד, תלחץ במקומי...  בטח למוצרט היה קל למות, כי הוא ידע שאחרי המוות שלו תשאר המוסיקה וכל מי שנשאר חי יוכל להאזין לה. ומה אתי? למה לא יצרתי כלום, אלוהים? כל כך הרבה זמן פנוי היה לי!",
      "start": 567.26,
      "end": 567.26,
      "interpolated": true
    },
    {
      "id": 111,
      "character": "לילי",
      "text": "(יוצאת וחוזרת/ חלון) הם באים. שימי.",
      "start": 567.26,
      "end": 567.26,
      "interpolated": true
    },
    {
      "id": 112,
      "character": "שמעון",
      "text": "מי זה בא?",
      "start": 567.26,
      "end": 567.26,
      "interpolated": true
    },
    {
      "id": 113,
      "character": "לילי",
      "text": "כולם באים! מאות, אלפי אנשים...",
      "start": 567.26,
      "end": 567.26,
      "interpolated": true
    },
    {
      "id": 114,
      "character": "שרה",
      "text": "אנשי הרוח, האמנות, השיווק, האהבה... מה להגיד להם?",
      "start": 567.26,
      "end": 567.26,
      "interpolated": true
    },
    {
      "id": 115,
      "character": "שמעון",
      "text": "שאני לא נמצא. לכי תגידי להם שאני לא יכול עכשיו, לילי!",
      "start": 567.26,
      "end": 567.26,
      "interpolated": true
    },
    {
      "id": 116,
      "character": "לילי",
      "text": "מה להגיד להם?",
      "start": 567.26,
      "end": 567.26,
      "interpolated": true
    },
    {
      "id": 117,
      "character": "שמעון",
      "text": "תגידי שאני עסוק. (מתעטף בתכריכים) אין לי זמן לדיבורים... תגידי שאני מת.",
      "start": 567.26,
      "end": 567.26,
      "interpolated": true
    },
    {
      "id": 118,
      "character": "שרה",
      "text": "מה נעשה, מה נעשה?",
      "start": 567.26,
      "end": 567.26,
      "interpolated": true
    }
  ]
}