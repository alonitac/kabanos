{
  "scene": "17",
  "characters": [
    "אינליאל",
    "לילי",
    "הרב",
    "שיראל",
    "שרה",
    "מישה"
  ],
  "lines": [
    {
      "id": 1,
      "character": "אינליאל",
      "text": "אתן מוכנות לילי?",
      "start": 0.0,
      "end": 1.6
    },
    {
      "id": 2,
      "character": "לילי",
      "text": "תסלח לי, אינלי...",
      "start": 2.24,
      "end": 4.06
    },
    {
      "id": 3,
      "character": "אינליאל",
      "text": "אל.",
      "start": 4.12,
      "end": 4.7
    },
    {
      "id": 4,
      "character": "לילי",
      "text": "למה אנחנו צריכות להיות מוכנות?",
      "start": 4.96,
      "end": 7.18
    },
    {
      "id": 5,
      "character": "הרב",
      "text": "הלוויתו של שימי בנבנישתי יוצאת לדרך. נאמר קדיש. אביו של המנוח פה?",
      "start": 9.12,
      "end": 12.22
    },
    {
      "id": 6,
      "character": "לילי",
      "text": "נפטר.",
      "start": 12.34,
      "end": 12.82
    },
    {
      "id": 7,
      "character": "הרב",
      "text": "אמו? בנו? בתו? (על הכל היא עונה בשלילה)",
      "start": 13.32,
      "end": 15.4
    },
    {
      "id": 8,
      "character": "הרב",
      "text": "אחיו?",
      "start": 18.98,
      "end": 19.38
    },
    {
      "id": 9,
      "character": "לילי",
      "text": "מיאמי... ובלגרד.",
      "start": null,
      "end": null
    },
    {
      "id": 10,
      "character": "הרב",
      "text": "אחיותיו?",
      "start": 31.16,
      "end": 32.66
    },
    {
      "id": 11,
      "character": "לילי",
      "text": "ליסבון, קופנגן, טורונטו ו..ערד.",
      "start": null,
      "end": null
    },
    {
      "id": 12,
      "character": "הרב",
      "text": "אשתו?",
      "start": 44.64,
      "end": 46.64
    },
    {
      "id": 13,
      "character": "לילי",
      "text": "זאת אני, אבל כבוד הרב... הוא חי!",
      "start": null,
      "end": null
    },
    {
      "id": 14,
      "character": "הרב",
      "text": "מה זאת אומרת חי?",
      "start": 67.68,
      "end": 68.3
    },
    {
      "id": 15,
      "character": "אינליאל",
      "text": "הוא חי, בוודאי , בלב של כולנו, ותמיד ימשיך לחיות...",
      "start": 93.3,
      "end": 94.04
    },
    {
      "id": 16,
      "character": "שיראל",
      "text": "נקים פיאצת הנצחה עם מזרקת אינפיניטי בבניין לזכרו מאמי,  מזמן רציתי מזרקה.",
      "start": 104.04,
      "end": 104.58
    },
    {
      "id": 17,
      "character": "שרה",
      "text": "הוא באמת חי! תקום, חתיכת אלכוהוליסט מסריח!",
      "start": 107.58,
      "end": 108.12
    },
    {
      "id": 18,
      "character": "שיראל",
      "text": "השכול, השכול מערער את השפיות. לייסטר, חראם.",
      "start": 113.04,
      "end": 113.62
    },
    {
      "id": 19,
      "character": "מישה",
      "text": "נו, זו תופעה ידועה, זה בגלל שהן לא ציפו, אני עצמי קברתי את אשתי לא מזמן. לא הצלחתי לישון בלילה. תשאלי אפילו את מרגריטה, היא עדה.",
      "start": null,
      "end": null
    },
    {
      "id": 20,
      "character": "שיראל",
      "text": "אני כשכנה גם עדה, שמעתי היטב .",
      "start": null,
      "end": null
    },
    {
      "id": 21,
      "character": "מישה",
      "text": "טוב, אם זה המצב, כשכן, אני הכי קרוב אליו... למדתי זה באולפן יִתְגַּדַּל וְיִתְקַדַּשׁ שמי ר....",
      "start": null,
      "end": null
    },
    {
      "id": 22,
      "character": "לילי",
      "text": "מישה!",
      "start": null,
      "end": null
    },
    {
      "id": 23,
      "character": "אינליאל",
      "text": "רגע, רגע! בן אדם כמו שימי אי אפשר לקבור ככה, בתכריכים, כמו חתול.",
      "start": null,
      "end": null
    },
    {
      "id": 24,
      "character": "הרב",
      "text": "מה אתה רוצה שנעשה אתו בדיוק?",
      "start": null,
      "end": null
    },
    {
      "id": 25,
      "character": "אינליאל",
      "text": "שמעון צריך להקבר בארוןֿ, טקס חילוני, תרבותי, עם טקסט מכבד, משהו של ביאליק.",
      "start": null,
      "end": null
    },
    {
      "id": 26,
      "character": "הרב",
      "text": "חס ושלום, כופר בן כופר, שיהודי יקבר בארון?!",
      "start": null,
      "end": null
    },
    {
      "id": 27,
      "character": "אינליאל",
      "text": "זה מה שהמנוח היה רוצה! הוא היה אדם מתקדם! אתאיסט ואיש תרבות!",
      "start": null,
      "end": null
    },
    {
      "id": 28,
      "character": "הרב",
      "text": "על מי ששם ידו בנפשו לא אומרים קדיש, ולא שיר של ביאליק ולא שום דבר!",
      "start": null,
      "end": null
    },
    {
      "id": 29,
      "character": "אינליאל",
      "text": "פרימיטיב.",
      "start": null,
      "end": null
    },
    {
      "id": 30,
      "character": "הרב",
      "text": "קוקסינל...",
      "start": null,
      "end": null
    },
    {
      "id": 31,
      "character": "לילי",
      "text": "די!! זה בעלי שם..הוא חי!",
      "start": 113.72,
      "end": 115.22
    },
    {
      "id": 32,
      "character": "הרב",
      "text": "מה לעשות, זאת ההלכה.",
      "start": null,
      "end": null
    },
    {
      "id": 33,
      "character": "שרה",
      "text": "פרחחים, עצרו!",
      "start": null,
      "end": null
    },
    {
      "id": 34,
      "character": "מישה",
      "text": "פיזדייץ",
      "start": null,
      "end": null
    },
    {
      "id": 35,
      "character": "שיראל",
      "text": "תפסיקו, זה כתם על היוקרה של הבניין!",
      "start": null,
      "end": null
    }
  ]
}